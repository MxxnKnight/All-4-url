# Copy to .env for local runs, or set these in your host's dashboard
# (Koyeb: Service -> Environment variables; Hugging Face: Space ->
# Settings -> Variables and secrets). NEVER commit a real .env.

# --- Required -------------------------------------------------------------
# From https://my.telegram.org/apps
API_ID=
API_HASH=
# From @BotFather on Telegram
BOT_TOKEN=
# Your own numeric Telegram user id (ask @userinfobot). The bot ignores
# absolutely everyone else.
OWNER_ID=
# Extra user ids allowed to use the bot exactly like you (full features).
# Space- or comma-separated, e.g. SUDO_USERS="111111111 222222222".
# Permanent — survives restarts. Only you (the owner) can add/remove
# sudo users; /addsudo adds temporary ones instead.
SUDO_USERS=

# --- Restricted downloader (optional) -------------------------------------
# Session string of your user account; generate with: python gen_session.py
# Password-equivalent — env var only, never a file in this repo.
SESSION_STRING=

# --- Database (optional, recommended) --------------------------------------
# MongoDB connection string (e.g. MongoDB Atlas). Stores the sudo users
# added with /addsudo, the usage stats (daily/monthly/total, up and
# down) AND the cookie jars, so they all survive redeploys. DB_NAME is
# THIS bot's own database on that cluster — the same DB_URI can be
# shared with your other bots, each with its own DB_NAME.
# Note: cookie jars in the DB = anyone with this URI can use those
# sessions. Throwaway accounts only, never your main accounts.
# Leave DB_URI empty to use local JSON files instead.
DB_URI=
DB_NAME=all4url

# --- Bandwidth guard ---------------------------------------------------------
# Monthly outbound cap in GB (uploads to Telegram + link serves).
# Hugging Face publishes no egress cap, so the code default is 1000
# (a runaway safety, not a real constraint) — but the owner keeps
# the live guard at 100 (HF's real bandwidth is unproven, and 100
# is plenty). The bot warns you at BANDWIDTH_WARN_PCT and pauses
# new download jobs at BANDWIDTH_STOP_PCT (streaming links keep
# working).
OUTBOUND_CAP_GB=100
BANDWIDTH_WARN_PCT=80
BANDWIDTH_STOP_PCT=95

# --- File-to-link ----------------------------------------------------------
# Nothing else is needed for file-to-link: by default you just send a
# file to the bot in PM and the links read it back from that message
# (so don't delete the message, or its links break).
# Public URL of this deployment, e.g. https://all-4-url-<you>.koyeb.app
# — the one required setting for the feature, so links can point here.
BASE_URL=
# OPTIONAL permanent mode: id of a private channel the bot copies files
# into first (bot must be admin; looks like -1001234567890). Links then
# survive the original PM message being deleted. Also used as the backup
# vault (cookie jars, sudo list, usage stats). Leave empty for PM mode —
# backups then live in your PM with the bot instead, no setup needed.
STORAGE_CHANNEL_ID=
# Port for the built-in web server. Koyeb sets this itself (8080);
# Hugging Face Spaces route 7860, which is also the code default —
# set PORT=7860 in the Space variables to be explicit.
PORT=8080
# Hours before download/stream links stop working.
LINK_EXPIRY_HOURS=72

# --- Terabox (optional) -----------------------------------------------------
# The `ndus` cookie of a logged-in terabox.com account (see README).
TERABOX_NDUS=
# The `BDUSS` cookie of the same account (optional; either cookie alone
# enables the cookie route, both together are sent together).
TERABOX_BDUSS=

# --- Reddit OAuth (optional) --------------------------------------------------
# Client ID + secret of a Reddit "script" app (reddit.com/prefs/apps).
# Lets the bot fetch Reddit posts through Reddit's official API
# instead of scraping (no cookie jar needed). Leave both empty to
# keep Reddit on gallery-dl + cookies exactly as before.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Tuning -----------------------------------------------------------------
# Simultaneous jobs. 4 suits the HF Space (2 CPU, 16 GB RAM);
# downloads mostly wait on the network, and FloodWait retry,
# 1 s send pacing, the big-file lock and the browser lock all
# still apply. Was 2 on the Koyeb free nano.
MAX_JOBS=4
# Where downloads are staged before upload (ephemeral on free hosts).
DOWNLOAD_DIR=downloads
# Byte-split downloads: files over the 2 GB Telegram cap go out as
# .001/.002 parts of this size, up to this total per file.
# SPLIT_PART_BYTES=1950000000
# SPLIT_MAX_TOTAL_GB=20
# /vidsplit part size in MB (50-1900, default 1000): 1900 gives the
# fewest parts, 500 gives smaller ones. Parts must stay under
# Telegram's 2 GB cap, so anything over 1900 is clamped back.
# SEGMENT_MAX_MB=1000
# /live part length in minutes (5-60, default 15): a live stream is
# cut into standalone MP4 parts of this length, sent as they finish.
# LIVE_SEGMENT_MIN=15
# Parallel downloads for direct links of 20 MB or more (4 Range
# connections instead of one stream; any failure falls back to
# single-stream). 1 = on (default), 0 = every download single-stream.
# PARALLEL_DOWNLOADS=1
