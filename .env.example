# Copy to .env for local runs, or set these in your host's dashboard
# (Koyeb: Service -> Environment variables). NEVER commit a real .env.

# --- Required -------------------------------------------------------------
# From https://my.telegram.org/apps
API_ID=
API_HASH=
# From @BotFather on Telegram
BOT_TOKEN=
# Your own numeric Telegram user id (ask @userinfobot). The bot ignores
# absolutely everyone else.
OWNER_ID=
# Extra user ids allowed to use the bot exactly like you (full features).
# Space- or comma-separated, e.g. SUDO_USERS="111111111 222222222".
# Permanent — survives restarts. Only you (the owner) can add/remove
# sudo users; /addsudo adds temporary ones instead.
SUDO_USERS=

# --- Restricted downloader (optional) -------------------------------------
# Session string of your user account; generate with: python gen_session.py
# Password-equivalent — env var only, never a file in this repo.
SESSION_STRING=

# --- File-to-link ----------------------------------------------------------
# Nothing else is needed for file-to-link: by default you just send a
# file to the bot in PM and the links read it back from that message
# (so don't delete the message, or its links break).
# Public URL of this deployment, e.g. https://all-4-url-<you>.koyeb.app
# — the one required setting for the feature, so links can point here.
BASE_URL=
# OPTIONAL permanent mode: id of a private channel the bot copies files
# into first (bot must be admin; looks like -1001234567890). Links then
# survive the original PM message being deleted. ALSO the backup vault:
# cookie jars, the sudo list and usage stats are backed up there and
# restored on startup, so they survive Render's disk wipes on redeploy.
# Leave empty for PM mode (backups disabled too).
STORAGE_CHANNEL_ID=
# Port for the built-in web server (hosts set this themselves).
PORT=8080
# Hours before download/stream links stop working.
LINK_EXPIRY_HOURS=72

# --- Terabox (optional) -----------------------------------------------------
# The `ndus` cookie of a logged-in terabox.com account (see README).
TERABOX_NDUS=

# --- Tuning -----------------------------------------------------------------
# Simultaneous jobs. 2 suits the Koyeb free nano; do not raise it there.
MAX_JOBS=2
# Where downloads are staged before upload (ephemeral on free hosts).
DOWNLOAD_DIR=downloads
